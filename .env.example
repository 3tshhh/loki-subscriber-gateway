# development | production | test — set to `test` to silence all console
# logging (Nest's Logger and the per-request logger). Test runners normally
# set this automatically; you shouldn't need to touch it locally.
NODE_ENV=development

# HTTP server
PORT=3000

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=subscriber_gateway

# Redis — redis://[:password@]host:port/db
REDIS_URL=redis://100.69.82.115:6379/0

# On startup, if a consumer group's undelivered backlog (from jobs:notify or
# jobs:delivering) exceeds this many entries — e.g. after an unusually long
# outage — the oldest excess is dropped (deleted, never delivered) and only
# the newest N are processed, so a huge pile of stale backlog can't flood
# subscribers at once. Optional — defaults to 250 if unset.
JOB_STREAM_BACKLOG_CAP=250

# Telegram — long-polling only, no public endpoint needed
TELEGRAM_BOT_TOKEN=

# Hostname of the link shortener. A job link on this domain gets ?userId=<chatId>
# appended before sending; a link on any other domain is left untouched.
# e.g. short.example.com
SHORT_URL_DOMAIN=
