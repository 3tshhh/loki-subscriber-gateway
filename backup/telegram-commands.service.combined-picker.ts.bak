import { Inject, Injectable, Logger, OnModuleInit } from '@nestjs/common';
import { Bot, Context } from 'grammy';
import { BOT } from '../bot.provider';
import { CoreApiClient } from '../core-api.client';
import {
  buildSelectorKeyboard,
  selectorCaption,
  SelectorMode,
} from './selector.util';

@Injectable()
export class TelegramCommandsService implements OnModuleInit {
  private readonly logger = new Logger(TelegramCommandsService.name);

  constructor(
    @Inject(BOT) private readonly bot: Bot,
    private readonly coreApi: CoreApiClient,
  ) {}

  onModuleInit() {
    this.bot.command('start', (ctx) => this.handleStart(ctx));
    this.bot.command('stop', (ctx) => this.handleStop(ctx));
    this.bot.command('categories', (ctx) =>
      this.handleSelector(ctx, 'categories'),
    );
    this.bot.command('sources', (ctx) => this.handleSelector(ctx, 'sources'));
    this.bot.on('callback_query:data', (ctx) => this.handleToggle(ctx));
  }

  private async handleStart(ctx: Context): Promise<void> {
    if (!ctx.chat) return;
    const chatId = String(ctx.chat.id);
    await this.coreApi.upsertUser(chatId);
    await this.sendSelector(ctx, chatId, 'both');
  }

  private async handleStop(ctx: Context): Promise<void> {
    if (!ctx.chat) return;
    const chatId = String(ctx.chat.id);
    try {
      await this.coreApi.deactivateUser(chatId);
      await ctx.reply(
        "You've been unsubscribed from all notifications. Send /start any time to come back — your categories and sources will be waiting for you.",
      );
    } catch (err) {
      this.logger.error(
        `Failed to deactivate chat ${chatId}: ${(err as Error).message}`,
        (err as Error).stack,
      );
      await ctx.reply('Something went wrong, please try again.');
    }
  }

  private async handleSelector(
    ctx: Context,
    mode: SelectorMode,
  ): Promise<void> {
    if (!ctx.chat) return;
    const chatId = String(ctx.chat.id);
    await this.sendSelector(ctx, chatId, mode);
  }

  private async sendSelector(
    ctx: Context,
    chatId: string,
    mode: SelectorMode,
  ): Promise<void> {
    const [categories, sources, subscriptions] = await Promise.all([
      this.coreApi.getCategories(),
      this.coreApi.getSources(),
      this.coreApi.getSubscriptions(chatId),
    ]);

    const keyboard = buildSelectorKeyboard(
      mode,
      categories,
      subscriptions.categoryIds,
      sources,
      subscriptions.sourceIds,
    );

    await ctx.reply(selectorCaption(mode), { reply_markup: keyboard });
  }

  private async handleToggle(ctx: Context): Promise<void> {
    const data = ctx.callbackQuery?.data;
    if (!data || !ctx.chat) return;

    const [, kind, idStr, mode] = data.split(':') as [
      string,
      'cat' | 'src',
      string,
      SelectorMode,
    ];
    const id = Number(idStr);
    const chatId = String(ctx.chat.id);

    try {
      const current = await this.coreApi.getSubscriptions(chatId);
      const categoryIds = new Set(current.categoryIds);
      const sourceIds = new Set(current.sourceIds);

      if (kind === 'cat') {
        if (categoryIds.has(id)) categoryIds.delete(id);
        else categoryIds.add(id);
      } else {
        if (sourceIds.has(id)) sourceIds.delete(id);
        else sourceIds.add(id);
      }

      const updated = await this.coreApi.updateSubscriptions(
        chatId,
        [...categoryIds],
        [...sourceIds],
      );

      const [categories, sources] = await Promise.all([
        this.coreApi.getCategories(),
        this.coreApi.getSources(),
      ]);
      const keyboard = buildSelectorKeyboard(
        mode,
        categories,
        updated.categoryIds,
        sources,
        updated.sourceIds,
      );

      await ctx.editMessageReplyMarkup({ reply_markup: keyboard });
      await ctx.answerCallbackQuery({ text: 'Updated' });
    } catch (err) {
      this.logger.error(
        `Failed to toggle subscription: ${(err as Error).message}`,
        (err as Error).stack,
      );
      await ctx.answerCallbackQuery({
        text: 'Something went wrong, please try again.',
      });
    }
  }
}
